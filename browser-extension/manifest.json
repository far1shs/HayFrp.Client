{
  "manifest_version": 3,
  "name": "HayFrp Console Helper",
  "version": "1.0.0",
  "description": "HayFrp 控制台助手 - 自动注入 CSRF 和快速切换账号",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://console.hayfrp.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://console.hayfrp.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}

